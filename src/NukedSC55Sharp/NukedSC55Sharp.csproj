<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>netstandard2.1;net8.0;net10.0</TargetFrameworks>
        <RootNamespace>NukedSC55Sharp</RootNamespace>
        <AssemblyName>NukedSC55Sharp</AssemblyName>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Deterministic>true</Deterministic>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>Nuked-SC55-Sharp</PackageId>
        <Title>Nuked-SC55-Sharp</Title>
        <Authors>Stefan Hueg</Authors>
        <Company>codengine</Company>
        <Description>C# bindings and cross-platform native binaries for Nuked-SC55 emulation.</Description>
        <Copyright>2026 Stefan Hueg and Nuked-SC55 contributors</Copyright>
        <Version>0.7.0</Version>
        <AssemblyVersion>0.7.0</AssemblyVersion>
        <FileVersion>0.7.0</FileVersion>
        <PackageProjectUrl>https://github.com/codengine/Nuked-SC55-Sharp</PackageProjectUrl>
        <RepositoryUrl>https://github.com/codengine/Nuked-SC55-Sharp</RepositoryUrl>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>sc55;sound-canvas;midi;synth;emulator</PackageTags>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <EnablePackageValidation>true</EnablePackageValidation>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All"
                          Condition="'$(ContinuousIntegrationBuild)' == 'true'" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
        <None Include="..\..\README.md" Pack="true" PackagePath="" />
        <None Include="..\..\THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="" />
        <None Include="..\..\.artifacts\source\Nuked-SC55-Sharp-native-source.zip"
              Pack="true" PackagePath="native-source/"
              Condition="Exists('..\..\.artifacts\source\Nuked-SC55-Sharp-native-source.zip')" />
        <None Include="..\..\.artifacts\native\win-x64\NukedSC55Sharp.Native.dll"
              Pack="true" PackagePath="runtimes/win-x64/native/"
              Condition="Exists('..\..\.artifacts\native\win-x64\NukedSC55Sharp.Native.dll')" />
        <None Include="..\..\.artifacts\native\win-arm64\NukedSC55Sharp.Native.dll"
              Pack="true" PackagePath="runtimes/win-arm64/native/"
              Condition="Exists('..\..\.artifacts\native\win-arm64\NukedSC55Sharp.Native.dll')" />
        <None Include="..\..\.artifacts\native\linux-x64\libNukedSC55Sharp.Native.so"
              Pack="true" PackagePath="runtimes/linux-x64/native/"
              Condition="Exists('..\..\.artifacts\native\linux-x64\libNukedSC55Sharp.Native.so')" />
        <None Include="..\..\.artifacts\native\linux-arm64\libNukedSC55Sharp.Native.so"
              Pack="true" PackagePath="runtimes/linux-arm64/native/"
              Condition="Exists('..\..\.artifacts\native\linux-arm64\libNukedSC55Sharp.Native.so')" />
        <None Include="..\..\.artifacts\native\osx-x64\libNukedSC55Sharp.Native.dylib"
              Pack="true" PackagePath="runtimes/osx-x64/native/"
              Condition="Exists('..\..\.artifacts\native\osx-x64\libNukedSC55Sharp.Native.dylib')" />
        <None Include="..\..\.artifacts\native\osx-arm64\libNukedSC55Sharp.Native.dylib"
              Pack="true" PackagePath="runtimes/osx-arm64/native/"
              Condition="Exists('..\..\.artifacts\native\osx-arm64\libNukedSC55Sharp.Native.dylib')" />
    </ItemGroup>
</Project>
