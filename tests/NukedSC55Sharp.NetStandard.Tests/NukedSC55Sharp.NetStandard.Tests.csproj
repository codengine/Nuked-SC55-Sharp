<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\NativeTestAsset.props" />
    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
        <PackageReference Include="xunit.v3" Version="4.0.0" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup>
        <Compile Include="..\NukedSC55Sharp.Tests\GlobalUsings.cs" Link="GlobalUsings.cs" />
        <Compile Include="..\NukedSC55Sharp.Tests\PublicContractTests.cs" Link="PublicContractTests.cs" />
        <ProjectReference Include="..\..\src\NukedSC55Sharp\NukedSC55Sharp.csproj"
                          SetTargetFramework="TargetFramework=netstandard2.1" />
    </ItemGroup>
</Project>
